# Feature flags (aligned with al-folio defaults)
NEXT_PUBLIC_ENABLE_GOOGLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_GOOGLE_VERIFICATION=true
NEXT_PUBLIC_ENABLE_BING_VERIFICATION=false

# Google Search Console verification token (meta name="google-site-verification")
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster verification token
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google Analytics Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Optional Google Tag Manager ID (e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
